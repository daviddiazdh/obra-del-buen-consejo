# Cambia todos los secretos antes de exponer el servicio en la red escolar.
POSTGRES_DB=obc
POSTGRES_USER=obc
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=replace-with-a-unique-admin-password
BOOTSTRAP_NAME=Administrador del sistema

# Telegram solo requiere el token; la aplicación descubre automáticamente el usuario público.
TELEGRAM_BOT_TOKEN=
# Opcional: permite evitar la consulta automática getMe al generar enlaces.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
INSTITUTION_NAME=Obra del Buen Consejo
SCHOOL_TIMEZONE=America/Caracas
TZ=America/Caracas

# Actualizaciones automáticas (CD) — ver sección "Actualizaciones" del README.
# Repositorio de GitHub donde se publican las versiones (owner/repo).
GITHUB_REPO=daviddiazdh/obra-del-buen-consejo
# Token de GitHub de solo lectura (scope "repo" si el repositorio es privado,
# o "public_repo" si es público) para consultar la última versión publicada.
GITHUB_TOKEN=
# Cada cuántos minutos el servidor revisa si hay una versión nueva.
CHECK_INTERVAL_MINUTES=30
# Ruta absoluta de ESTA carpeta en el servidor de la oficina (la misma donde
# vive este docker-compose.yml), tal como la ve el sistema operativo del
# servidor. Obligatoria: sin ella el botón "Actualizar" no puede funcionar.
# Ejemplos:
#   Linux/macOS: /home/colegio/obra-del-buen-consejo
#   Windows (Docker Desktop): C:\Users\colegio\obra-del-buen-consejo
HOST_PROJECT_DIR=
